cabal-version:       2.4
name:                lab4
version:             0.1.0.0
build-type:          Simple
author:              Unknown
maintainer:          you@example.com
license:             BSD-3-Clause
license-file:        LICENSE
synopsis:            Parser combinators with JSON parser
category:            Parser

library
  hs-source-dirs:   src
  exposed-modules:
      Parser.Core
    , Parser.Combinators
    , JSON.AST
    , JSON.Parser
    , JSON.FromJSON
    , JSON.Generic
  default-language: Haskell2010
  build-depends:
      base >=4.14 && <5

executable lab4
  hs-source-dirs:   src
  main-is:          Main.hs
  default-language: Haskell2010
  build-depends:
      base >=4.14 && <5
    , lab4

test-suite lab4-test
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Spec.hs
  default-language: Haskell2010
  build-depends:
      base >=4.14 && <5
    , lab4
